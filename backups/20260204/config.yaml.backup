SYS_MSG: |
  # PROMPT-BLOCK-START
  CONTEXT: You are optimizing a connectome-driven C. elegans locomotion simulator.

  GOAL:
  Evolve the code to maximize fitness by matching C. elegans kinematics and neural
  dynamics to real datasets (Dryad 2024 locomotion + WormWideWeb whole-brain activity).
  
  Current fitness: ~0.40 (target: >0.50)
  Fitness = 1 / (1 + total_loss) where total_loss = behavior_loss + neural_loss + 0.1*consistency_penalty
  
  LOSS COMPONENT WEIGHTS (focus here):
  Behavior Loss (weight 1.0):
    - curv_mean: 0.35 (HIGHEST PRIORITY - curvature along body segments)
    - curv_std: 0.25 (variation in curvature)
    - curv_psd: 0.20 (frequency content of curvature waves)
    - vel_mean: 0.10 (average speed)
    - vel_std: 0.05
    - vel_psd: 0.05
    - traj_speed_mean/std: 0.05 each
  
  Neural Loss (weight 1.0):
    - neural_mean: 0.4 (average firing rates)
    - neural_std: 0.2 (variability)
    - neural_corr: 0.4 (correlation structure between neurons)
  
  Consistency penalty (weight 0.1): positions vs velocities agreement

  NON-NEGOTIABLE REQUIREMENTS (MUST PASS EVALUATION):
  1) Load the real connectome from Excel (do NOT fabricate matrices).
  2) Use sheet names: "hermaphrodite chemical" and "hermaphrodite gap jn symmetric"
  3) Parse SI5 layout correctly (labels at row 3/col 4, data at row 4/col 4)
  4) Extract neuron-neuron submatrix from intersection of row/column labels
  5) All randomness seeded from CE_SEED environment variable
  6) Output EXACTLY one JSON line with all required keys

  EVOLUTION STRATEGY - MAKE SMALL, SAFE CHANGES:
  
  **PRIORITY 1: Parameter Tuning (SAFEST - do this first)**
  - Neural dynamics: alpha, beta, gamma, tau_* values
  - Motor control: base_speed, speed_gain, omega, turn_gain
  - Body mechanics: damping, spring_k, segment properties
  - Coupling strengths: pep_gain, gap coupling strength
  - Time constants: tau_syn, tau_m, tau_pep
  
  **PRIORITY 2: Curvature Generation (MOST IMPORTANT for fitness)**
  - Modify how motor drive maps to body curvature
  - Adjust phase_offsets distribution (currently linear, try nonlinear)
  - Tune traveling wave parameters (frequency, amplitude)
  - Add proprioceptive feedback: segment angles → motor neurons
  - Experiment with dorsal/ventral asymmetry weights
  
  **PRIORITY 3: Motor Readout Refinement**
  - Weighted combinations of motor neuron groups
  - Add interneuron contributions to drive signal
  - Smooth motor drive with exponential moving average
  - Try different drive formulas: sigmoid(fwd - bwd), tanh(weighted_sum)
  
  **PRIORITY 4: Neural Dynamics Tuning (if stable)**
  - Adjust noise levels
  - Tune synaptic time constants
  - Modify adaptive gain parameters
  - Balance excitation/inhibition
  
  **AVOID (these break code):**
  - Changing core architecture (keep LIF model as-is)
  - Modifying function signatures or return values
  - Adding new complex neuron models from scratch
  - Removing essential components
  - Large multi-line replacements
  
  EDITING RULES (CRITICAL):
  - Make ONE focused change per mutation
  - Use precise SEARCH/REPLACE (exact string match required)
  - Keep changes inside # EVOLVE-BLOCK-START / # EVOLVE-BLOCK-END only
  - Preserve all working components
  - Test that changes are syntactically valid
  
  STABILITY REQUIREMENTS:
  - Maintain spectral normalization for all weight matrices
  - Keep dt small (0.05-0.2 range)
  - Ensure all arrays have correct shapes
  - Clip extreme values to prevent NaN/inf
  - Run within 60s timeout per seed
  
  SPECIFIC IMPROVEMENT TARGETS:
  1. **Curvature statistics** (highest impact):
     - Current issue: likely too uniform/simple wave patterns
     - Try: variable phase offsets, feedback-driven modulation, segment coupling
  
  2. **Neural correlation structure**:
     - Current issue: correlation matrix may not match biological patterns
     - Try: adjust synaptic time constants, gap junction strength
  
  3. **Velocity dynamics**:
     - Current issue: speed transitions may be too abrupt
     - Try: smooth drive signal, momentum in movement
  
  KEYWORDS:
  parameter tuning, curvature generation, motor control, neural dynamics, stability, small changes
  # PROMPT-BLOCK-END

CODEBASE_PATH: "src/"
INIT_FILE_DATA: {filename: "init_program.py", language: "python"}
EVAL_FILE_NAME: "evaluate.py"
EVAL_TIMEOUT: 360

SEED: 42

MAX_MEM_BYTES: 5000000000
MEM_CHECK_INTERVAL_S: 0.1

EVOLVE_CONFIG:
  fitness_key: "fitness"
  num_epochs: 120
  ckpt: 10
  max_size: 60
  init_pop: 15

  exploration_rate: 0.30  # Reduced from 0.40 - less risky exploration
  selection_policy: roulette
  selection_kwargs: {roulette_by_rank: True}
  early_stopping_rounds: 60  # Increased patience

  num_islands: 2
  migration_topology: ring
  migration_interval: 5
  migration_rate: 0.25

  meta_prompting: True
  use_embedding: True
  use_map_elites: False

  num_inspirations: 3
  max_chat_depth: 3  # Allow refinement conversations

  mp_start_marker: "# PROMPT-BLOCK-START"
  mp_end_marker: "# PROMPT-BLOCK-END"
  evolve_start_marker: "# EVOLVE-BLOCK-START"
  evolve_end_marker: "# EVOLVE-BLOCK-END"

  use_scheduler: True
  type: PlateauScheduler
  scheduler_kwargs:
    min_rate: 0.10  # Lower minimum for safer exploitation
    max_rate: 0.30
    plateau_threshold: 8  # More patience before increasing exploration
    increase_factor: 1.08
    decrease_factor: 0.92

# Lower temperature for more conservative, stable mutations
EXPLORATION_ENSEMBLE:
  - {model_name: "qwen3-coder:480b-cloud", temp: 0.75, top_p: 0.88, retries: 5, weight: 0.6, verify_ssl: False}
  - {model_name: "deepseek-v3.2:cloud", temp: 0.72, top_p: 0.88, retries: 5, weight: 0.4, verify_ssl: False}

# Very conservative exploitation for stability
EXPLOITATION_ENSEMBLE:
  - {model_name: "glm-4.7:cloud", temp: 0.35, top_p: 0.85, retries: 5, weight: 0.7, verify_ssl: False}
  - {model_name: "devstral-2:123b-cloud", temp: 0.35, top_p: 0.85, retries: 5, weight: 0.3, verify_ssl: False}

SAMPLER_AUX_LM:
  {model_name: "glm-4.7:cloud", temp: 0.25, top_p: 0.85, retries: 5, weight: 1, verify_ssl: False}

EMBEDDING:
  {model_name: "qwen3-embedding:4b", retries: 3, verify_ssl: False}
